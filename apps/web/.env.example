# Postgres (sem schema= na query: o driver postgres.js não aceita)
DATABASE_URL=postgresql://user:change-me@host:5432/linkq_db
# 32 bytes em base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PIX_KEY_ENCRYPTION_KEY=change-me-base64-32-bytes
# Origem pública eterna, gravada nas tags NFC e QR
APP_BASE_URL=https://gerelink.online
